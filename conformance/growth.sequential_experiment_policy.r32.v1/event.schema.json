    "publish_transaction_id": {"type":"string"},
    "creator_session_id": {"type":"string"},
    "published_candidate_id": {"type":"string"},
    "published_render_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "exposure_id": {"type":"string"},
    "exposure_at": {"type":"string"},
    "metric_captured_at": {"type":"string"},
    "platform": {"type":"string"},
    "account_pseudonym": {"type":"string"},
    "topic_cluster": {"type":"string"},
    "source_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_version": {"const":1},
    "policy_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "metric_schema_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "metric_definition_hash": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "primary_metric": {"const":"completion_rate"},
    "primary_value": {"type":["number","null"],"minimum":0,"maximum":1},
    "guardrails": {"type":"object"},
    "missing_metrics": {"type":"array"},
    "randomized": {"type":["object","null"]},
    "fixture": {"type":"boolean"}
  }
}
