{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.post_publish_learning.v1",
  "title": "Growth post-publish learning v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "learning_id",
    "learning_digest",
    "learning_revision",
    "source_class",
    "live_performance_claim_allowed",
    "next_cycle_id",
    "lineage",
    "observed_provider_metrics",
    "derived_analytics",
    "speculative_hypotheses",
    "runtime_state",
    "candidate_decision",
    "unavailable_evidence",
    "evidence_state",
    "evidence_blockers",
    "causality",
    "authority",
    "interpretation"
  ],
  "properties": {
    "contract_version": {"const": "growth.post_publish_learning.v1"},
    "learning_id": {"type": "string", "pattern": "^gppl1:[0-9a-f]{64}$"},
    "learning_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "learning_revision": {"type": "integer", "minimum": 1},
    "source_class": {"enum": ["platform_export", "synthetic_fixture"]},
    "live_performance_claim_allowed": {"type": "boolean"},
    "next_cycle_id": {"type": "string", "minLength": 1},
    "lineage": {
      "type": "object",
      "required": [
        "publish_result_id",
        "publish_result_digest",
        "platform",
        "account_id",
        "post_id",
        "cycle_revision",
        "provider_receipt_digest",
        "media_artifact_id",
        "media_render_sha256",
        "metric_snapshot_digest",
        "selected_metrics_event_id",
        "observation_window"
      ]
    },
    "observed_provider_metrics": {"type": "object"},
    "derived_analytics": {"type": "object"},
    "speculative_hypotheses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6
    },
    "runtime_state": {"type": "object"},
    "candidate_decision": {"type": ["object", "null"]},
    "unavailable_evidence": {"type": "object"},
    "evidence_state": {
      "enum": ["insufficient_or_delayed", "directional_observational"]
    },
    "evidence_blockers": {"type": "array"},
    "causality": {
      "type": "object",
      "properties": {
        "historical_performance_may_prioritize_hypotheses": {"const": true},
        "historical_performance_proves_causality": {"const": false},
        "retroactive_human_preference_inference": {"const": false},
        "hypotheses_are_speculative": {"const": true}
      }
    },
    "authority": {
      "type": "object",
      "properties": {
        "advisory_only": {"const": true},
        "provider_mutation": {"const": false},
        "publish_authorized": {"const": false},
        "creator_mutation": {"const": false},
        "media_mutation": {"const": false},
        "release_authorized": {"const": false}
      }
    },
    "interpretation": {"type": "string", "minLength": 1}
  }
}
