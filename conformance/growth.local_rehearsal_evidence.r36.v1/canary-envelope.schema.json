{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"growth.local_canary_evidence_envelope.r36.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["contract_version","envelope_digest","state","disposition","source_class","readiness_eligible","registry_submission_allowed","live_authorization","provider_mutation_allowed","creator_mutation_allowed","publish_allowed","credential_access_allowed","normalization_digest","decision_digest","consensus_digest","bundle_manifest_digest","source","candidates","review_round","parent_r35","parent_qa_disposition","authority_manifest_digest","policy_digest","fixture","human_ground_truth"],
  "properties":{
    "contract_version":{"const":"growth.local_canary_evidence_envelope.r36.v1"},
    "envelope_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "state":{"enum":["WAITING_PARENT_QA","LOCAL_REHEARSAL_EVIDENCE_READY"]},
    "disposition":{"const":"ADVISORY_ONLY"},
    "source_class":{"enum":["SYNTHETIC_TEST","OFF_POLICY_REPLAY"]},
    "readiness_eligible":{"const":false},
    "registry_submission_allowed":{"const":false},
    "live_authorization":{"const":false},
    "provider_mutation_allowed":{"const":false},
    "creator_mutation_allowed":{"const":false},
    "publish_allowed":{"const":false},
    "credential_access_allowed":{"const":false},
    "normalization_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "decision_digest":{"type":["string","null"]},
    "consensus_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "bundle_manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source":{"type":"object"},
    "candidates":{"type":"array","minItems":2,"maxItems":2},
    "review_round":{"type":"integer","minimum":0,"maximum":2},
    "parent_r35":{"type":"object"},
    "parent_qa_disposition":{"enum":["PENDING","ACCEPTED"]},
    "authority_manifest_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "fixture":{"type":"boolean"},
    "human_ground_truth":{"const":false}
  }
}
