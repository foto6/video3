{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"growth.local_review_normalization.r36.v1",
  "type":"object",
  "additionalProperties":false,
  "required":["contract_version","normalization_digest","bundle_id","bundle_manifest_digest","fixture","session_id","session_identity","review_round","package_digest","r29_package_digest","prompt_digest","sealed_mapping_digest","source","candidates","reviews","consensus","authority","boundary"],
