{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.shadow_canary_readiness_certificate.r35.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version","certificate_id","certificate_digest","status","disposition",
    "registry_id","registry_snapshot_digest","as_of","policy_digest",
    "policy_corpus_authority_tuple","readiness","reason_codes","evidence_entries_used",
    "excluded_entries","negative_history_entry_ids","critical_veto_entry_ids",
    "unresolved_conflicts","aggregation_summary","live_authorization",
    "provider_mutation_allowed","creator_mutation_allowed","browser_mutation_allowed",
    "traffic_allocation_allowed","publish_allowed","credential_access_allowed",
    "human_ground_truth","creator_advisory"
  ],
  "properties": {
    "contract_version": {"const":"growth.shadow_canary_readiness_certificate.r35.v1"},
    "certificate_id": {"type":"string","pattern":"^gr35cert1:[0-9a-f]{64}$"},
    "certificate_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "status": {"const":"ADVISORY_ONLY_SOURCE_READY"},
    "disposition": {"const":"ADVISORY_ONLY"},
    "registry_id": {"type":"string"},
    "registry_snapshot_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "as_of": {"type":"string"},
    "policy_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "policy_corpus_authority_tuple": {"type":"object"},
    "readiness": {"enum":["NOT_READY","TEST_MORE","SHADOW_CANARY_CANDIDATE","HUMAN_REVIEW_REQUIRED","SHADOW_ROLLBACK"]},
    "reason_codes": {"type":"array","items":{"type":"string"}},
    "evidence_entries_used": {"type":"array","items":{"type":"string"}},
    "excluded_entries": {"type":"array"},
    "negative_history_entry_ids": {"type":"array","items":{"type":"string"}},
    "critical_veto_entry_ids": {"type":"array","items":{"type":"string"}},
    "unresolved_conflicts": {"type":"array"},
    "aggregation_summary": {"type":"object"},
    "live_authorization": {"const":false},
    "provider_mutation_allowed": {"const":false},
    "creator_mutation_allowed": {"const":false},
    "browser_mutation_allowed": {"const":false},
    "traffic_allocation_allowed": {"const":false},
    "publish_allowed": {"const":false},
    "credential_access_allowed": {"const":false},
    "human_ground_truth": {"const":false},
    "creator_advisory": {"type":"object"}
  }
}
