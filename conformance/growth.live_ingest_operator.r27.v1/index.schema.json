{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.dynamic_live_review_ingest_index.r27.v1",
  "title": "Growth R27 dynamic live-review coordinator index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "index_id",
    "index_digest",
    "state",
    "live_capture_gate",
    "new_ingest_effect",
    "growth_r27",
    "media_r21",
    "bridge_r30",
    "capture",
    "pairwise",
    "selected_result",
    "candidates",
    "rejection_reason",
    "evidence_boundary"
  ],
  "properties": {
    "contract_version": {
      "const": "growth.dynamic_live_review_ingest_index.r27.v1"
    },
    "index_id": {
      "type": "string",
      "pattern": "^gr27idx1:[0-9a-f]{64}$"
    },
    "index_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "state": {
      "enum": [
        "SOURCE_READY",
        "LIVE_REVIEW_INGESTED",
        "BLOCKED_WAITING_GENUINE_CAPTURE",
        "MALFORMED_MODEL_RESPONSE"
      ]
    },
    "live_capture_gate": {
      "type": "string"
    },
    "new_ingest_effect": {
      "type": "boolean"
    },
    "growth_r27": {
      "type": "object"
    },
    "media_r21": {
      "type": "object"
    },
    "bridge_r30": {
      "type": "object"
    },
    "capture": {
      "type": [
        "object",
        "null"
      ]
    },
    "pairwise": {
      "type": [
        "object",
        "null"
      ]
    },
    "selected_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "candidates": {
      "type": "object"
    },
    "rejection_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_evidence",
        "human_ground_truth",
        "human_rating_evidence",
        "human_parity_inferred",
        "fixture_promoted",
        "provider_mutation",
        "browser_mutation",
        "creator_mutation",
        "media_mutation"
      ],
      "properties": {
        "model_evidence": {
          "type": "boolean"
        },
        "human_ground_truth": {
          "const": false
        },
        "human_rating_evidence": {
          "const": false
        },
        "human_parity_inferred": {
          "const": false
        },
        "fixture_promoted": {
          "const": false
        },
        "provider_mutation": {
          "const": false
        },
        "browser_mutation": {
          "const": false
        },
        "creator_mutation": {
          "const": false
        },
        "media_mutation": {
          "const": false
        }
      }
    }
  }
}
