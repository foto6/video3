{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.live_ingest_operator_index.r27.v1",
  "title": "Growth R27 live-ingest coordinator index",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "index_id",
    "index_digest",
    "state",
    "live_capture_gate",
    "operator",
    "creator_target",
    "media",
    "bridge",
    "creator_r29_bridge_authority",
    "capture",
    "pairwise",
    "selected_result",
    "candidate_results",
    "evidence_boundary"
  ],
  "properties": {
    "contract_version": {
      "const": "growth.live_ingest_operator_index.r27.v1"
    },
    "index_id": {
      "type": "string",
      "pattern": "^gr27idx1:[a-f0-9]{64}$"
    },
    "index_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "state": {
      "enum": [
        "SOURCE_READY",
        "LIVE_REVIEW_INGESTED"
      ]
    },
    "live_capture_gate": {
      "enum": [
        "BLOCKED_WAITING_DYNAMIC_CAPTURE",
        "SATISFIED_DYNAMIC_CAPTURE_CONSUMED"
      ]
    },
    "operator": {
      "type": "object"
    },
    "creator_target": {
      "type": "object",
      "required": [
        "repository",
        "observed_r29_sha",
        "observed_r29_ci_run_id",
        "envelope_contract",
        "manual_envelope_edit_required",
        "implementation_blob_sha1"
      ]
    },
    "media": {
      "type": "object"
    },
    "bridge": {
      "type": [
        "object",
        "null"
      ]
    },
    "capture": {
      "type": [
        "object",
        "null"
      ]
    },
    "pairwise": {
      "type": [
        "object",
        "null"
      ]
    },
    "selected_result": {
      "type": [
        "object",
        "null"
      ]
    },
    "candidate_results": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "model_facing_label",
          "state",
          "candidate_round",
          "creator_compat_candidate_round",
          "render_sha256",
          "attachment_sha256",
          "source_handoff_digest",
          "handoff_digest",
          "envelope_file",
          "envelope_digest"
        ],
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1
          },
          "model_facing_label": {
            "enum": [
              "A",
              "B"
            ]
          },
          "candidate_round": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "creator_compat_candidate_round": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2
          },
          "source_handoff_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "handoff_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "envelope_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "evidence_boundary": {
      "type": "object",
      "required": [
        "model_evidence",
        "human_ground_truth",
        "human_rating_evidence",
        "human_parity_inferred",
        "live_platform_evidence"
      ],
      "properties": {
        "human_ground_truth": {
          "const": false
        },
        "human_rating_evidence": {
          "const": false
        },
        "human_parity_inferred": {
          "const": false
        },
        "live_platform_evidence": {
          "const": false
        }
      }
    },
    "creator_r29_bridge_authority": {
      "type": [
        "object",
        "null"
      ]
    }
  }
}
