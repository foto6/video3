{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.randomized_assignment_exposure.r31.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "experiment_id",
    "assignment_id",
    "assignment_digest",
    "exposure_id",
    "exposure_digest",
    "publish_result_id",
    "randomization_seed",
    "randomization_method",
    "allocation_ratio",
    "treatment",
    "assignment_at",
    "exposure_at",
    "predeclared_window_class",
    "predeclared_primary_metric",
    "assigned_render_sha256",
    "observed_render_sha256",
    "treatment_visible_before_assignment",
    "creative_changed_after_assignment",
    "posthoc_window_selected",
    "source_class"
  ],
  "properties": {
    "contract_version": {"const": "growth.randomized_assignment_exposure.r31.v1"},
    "experiment_id": {"type": "string", "minLength": 1},
    "assignment_id": {"type": "string", "minLength": 1},
    "assignment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "exposure_id": {"type": "string", "minLength": 1},
    "exposure_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "publish_result_id": {"type": "string", "minLength": 1},
    "randomization_seed": {"type": "string", "minLength": 1},
    "randomization_method": {"const": "deterministic_sha256_bucket"},
    "allocation_ratio": {"const": 0.5},
    "treatment": {"enum": ["control", "treatment"]},
    "assignment_at": {"type": "string"},
    "exposure_at": {"type": "string"},
    "predeclared_window_class": {"enum": ["early", "mature"]},
    "predeclared_primary_metric": {"const": "completion_rate"},
    "assigned_render_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "observed_render_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "treatment_visible_before_assignment": {"const": false},
    "creative_changed_after_assignment": {"const": false},
    "posthoc_window_selected": {"const": false},
    "source_class": {"enum": ["platform_export", "synthetic_fixture"]}
  }
}
