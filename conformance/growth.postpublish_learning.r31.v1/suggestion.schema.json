{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.future_edit_policy_suggestion.r31.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "suggestion_id",
    "suggestion_digest",
    "status",
    "evidence_state",
    "authoritative_integration",
    "window_class",
    "account_pseudonym",
    "ranked_strategy_priors",
    "observational_strategy_evidence",
    "randomized_experiment_evidence",
    "drift",
    "confidence_and_uncertainty",
    "evidence_ids",
    "forbidden_conclusions",
    "recommended_next_experiment",
    "growth_r31",
    "evidence_boundary"
  ],
  "properties": {
    "contract_version": {"const": "growth.future_edit_policy_suggestion.r31.v1"},
    "suggestion_id": {"type": "string", "pattern": "^gr31p1:[0-9a-f]{64}$"},
    "suggestion_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "status": {"enum": ["LEARNING_SOURCE_READY", "WAITING_PARENT_QA", "INSUFFICIENT_EVIDENCE", "EXPERIMENT_EVIDENCE_READY"]},
    "evidence_state": {"enum": ["LEARNING_SOURCE_READY", "INSUFFICIENT_EVIDENCE", "EXPERIMENT_EVIDENCE_READY"]},
    "authoritative_integration": {"type": "boolean"},
    "window_class": {"enum": ["early", "mature"]},
    "account_pseudonym": {"type": "string"},
    "ranked_strategy_priors": {"type": "array"},
    "observational_strategy_evidence": {"type": "array"},
    "randomized_experiment_evidence": {"type": ["object", "null"]},
    "drift": {"type": "object"},
    "confidence_and_uncertainty": {"type": "object"},
    "evidence_ids": {"type": "array"},
    "forbidden_conclusions": {"type": "array"},
    "recommended_next_experiment": {"type": "object"},
    "growth_r31": {"type": "object"},
    "evidence_boundary": {"type": "object"}
  }
}
