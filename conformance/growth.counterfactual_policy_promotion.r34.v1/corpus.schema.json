{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "growth.counterfactual_replay_corpus.r34.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version","corpus_id","corpus_digest","frozen_at","evidence_mode",
    "metric_window_seconds","evaluation_split_id","evaluation_split_digest",
    "parent_r33_authority","source_portfolio_id","source_portfolio_digest",
    "source_r33_decision_digest","campaigns","critical_strata","critical_guardrails",
    "outcome_model","events"
  ],
  "properties": {
    "contract_version": {"const":"growth.counterfactual_replay_corpus.r34.v1"},
    "corpus_id": {"type":"string","minLength":1},
    "corpus_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "frozen_at": {"type":"string"},
    "evidence_mode": {"enum":["randomized_controlled","observational_monitoring"]},
    "metric_window_seconds": {"type":"integer","minimum":1},
    "evaluation_split_id": {"type":"string","minLength":1},
    "evaluation_split_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "parent_r33_authority": {"type":"object"},
    "source_portfolio_id": {"type":"string","minLength":1},
    "source_portfolio_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "source_r33_decision_digest": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "campaigns": {"type":"array","minItems":1},
    "critical_strata": {"type":"array"},
    "critical_guardrails": {"type":"array","minItems":1},
    "outcome_model": {"type":"object"},
    "events": {"type":"array","minItems":1}
  }
}
